# Copy to .env for local Docker development. Never commit .env.

NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Database (Railway Postgres injects DATABASE_URL automatically)
DATABASE_URL=postgresql://app:password@localhost:5432/focusflow
DATABASE_SSL=false

# Redis (Railway Redis injects REDIS_URL automatically)
REDIS_URL=redis://localhost:6379

# API
PORT=8080
FRONTEND_URL=http://localhost:5174

# Frontend build (set on Railway web service at BUILD time)
VITE_API_URL=http://localhost:8080

# AI — Groq example (compatible with OpenAI SDK)
OPENAI_API_KEY=your-groq-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# Slack (optional)
SLACK_VERIFICATION_TOKEN=

# Reminder / digest timezone (used for quiet hours 22:00–07:00 and 9am morning digest)
TZ=Europe/London

