# Copy to deploy/oracle/.env on the VM and fill in.
#   cp deploy/oracle/.env.example deploy/oracle/.env

# Public hostname (DuckDNS or any DNS A record → your Oracle public IP)
DOMAIN=mindsprint.duckdns.org

# Must match DOMAIN (used for CORS + Slack links)
FRONTEND_URL=https://mindsprint.duckdns.org

# Baked into the web image at build time (same host, /api via Caddy)
VITE_API_URL=https://mindsprint.duckdns.org/api

# Secrets — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# AI (Groq free tier works)
OPENAI_API_KEY=your-groq-or-openai-key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

TZ=Europe/London

# Slack Events / Home Tab / Workflows (set on the VM after creating the Slack app)
SLACK_SIGNING_SECRET=
SLACK_WORKFLOW_SECRET=
# Optional legacy verification token
SLACK_VERIFICATION_TOKEN=
